# DeepSeek API（OpenAI 兼容），复制本文件为 .env 后填入
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 接入其它 API 供应商（OpenAI 兼容口径即可，如通义千问/智谱/月之暗面）
# 每加一个供应商，按下面三条设置（<ID> 自定义，如 QWEN / ZHIPU / MOONSHOT）：
# PROVIDER_<ID>_NAME=通义千问
# PROVIDER_<ID>_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROVIDER_<ID>_KEY=sk-xxx
# PROVIDER_<ID>_MODELS=qwen-max,qwen-plus
